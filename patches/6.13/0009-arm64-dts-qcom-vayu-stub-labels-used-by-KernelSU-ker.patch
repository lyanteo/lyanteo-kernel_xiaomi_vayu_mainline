From 85c138ac8c91e14f91278e6a0cf12435e19fd573 Mon Sep 17 00:00:00 2001
From: lyanteo <lyanteo@users.noreply.github.com>
Date: Wed, 25 Nov 2026 06:49:25 +0000
Subject: [PATCH] arm64: dts: qcom: vayu: stub labels used by KernelSU kernel
 dtbo

The dtbo shipped by KernelSU vayu kernel zips (flashed over crDroid)
references tdm_sen_rx and tdm_sen_tx. Without them the bootloader fails
to apply the overlay and drops to fastboot before the kernel runs.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0192C5wPw4AwnF1EyMXZJ5bh
---
 .../arm64/boot/dts/qcom/sm8150-xiaomi-vayu-dtbo-compat.dtsi | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-vayu-dtbo-compat.dtsi b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-vayu-dtbo-compat.dtsi
index 441d3034137c..28f2810726e4 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-vayu-dtbo-compat.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-vayu-dtbo-compat.dtsi
@@ -6,7 +6,8 @@
  * (board-id 47, model "VAYU") on top of the kernel DTB and aborts the boot
  * (back to fastboot) if any label referenced by the overlay is missing.
  * The Infinity-X 3.12 overlay references 118 labels (crDroid: one more,
- * qupv3_se17_i2c) that only exist in the vendor 4.14 device tree.
+ * qupv3_se17_i2c; KernelSU kernel dtbo: tdm_sen_rx/tx) that only exist in
+ * the vendor 4.14 device tree.
  * Provide empty nodes for them inside a disabled container without
  * "compatible", so the overlay applies but nothing in it
  * is ever probed or used by the mainline kernel.
@@ -94,6 +95,9 @@ xiaomi-dtbo-compat {
 		qupv3_se17_spi: qupv3-se17-spi-stub { };
 		/* referenced by the crDroid vayu dtbo entry */
 		qupv3_se17_i2c: qupv3-se17-i2c-stub { };
+		/* referenced by the dtbo shipped with KernelSU vayu kernels */
+		tdm_sen_rx: tdm-sen-rx-stub { };
+		tdm_sen_tx: tdm-sen-tx-stub { };
 		qupv3_se1_spi: qupv3-se1-spi-stub { };
 		qupv3_se3_spi: qupv3-se3-spi-stub { };
 		qupv3_se4_i2c: qupv3-se4-i2c-stub { };
-- 
