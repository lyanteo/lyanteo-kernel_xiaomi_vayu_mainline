+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Compatibility stubs for the vendor dtbo overlay of Xiaomi POCO X3 Pro.
+ *
+ * The Qualcomm bootloader (ABL) applies the overlay from the dtbo partition
+ * (board-id 47, model "VAYU") on top of the kernel DTB and aborts the boot
+ * (back to fastboot) if any label referenced by the overlay is missing.
+ * The stock overlay references 118 labels that only exist in the vendor
+ * 4.14 device tree. Provide empty nodes for them inside a disabled
+ * container without "compatible", so the overlay applies but nothing in it
+ * is ever probed or used by the mainline kernel.
+ *
+ * Requires the DTB to be built with symbols (DTC_FLAGS=-@).
+ */
+
+/ {
+	xiaomi-dtbo-compat {
+		status = "disabled";
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		CPU0: cpu0-stub { };
