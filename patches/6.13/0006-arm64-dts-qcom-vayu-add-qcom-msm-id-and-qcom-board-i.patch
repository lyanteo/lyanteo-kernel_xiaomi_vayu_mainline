From cfe51874bc329e9dec7503ad4e4fb9ceccc7d515 Mon Sep 17 00:00:00 2001
From: lyanteo <lyanteo@users.noreply.github.com>
Date: Tue, 24 Nov 2026 18:10:22 +0000
Subject: [PATCH] arm64: dts: qcom: vayu: add qcom,msm-id and qcom,board-id

The Qualcomm bootloader (ABL) selects the DTB by msm-id/board-id; without
them it refuses to boot the image and falls back to fastboot. Values are
taken from the vendor tree (sm8150-v2.dtsi: <339 0x20000>,
vayu-sm8150-overlay.dts: <47 0>), same approach as sm8150-xiaomi-nabu.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0192C5wPw4AwnF1EyMXZJ5bh
---
 arch/arm64/boot/dts/qcom/sm8150-xiaomi-vayu.dts | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-vayu.dts b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-vayu.dts
index 118c755b7351..595037cf5cae 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-vayu.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-vayu.dts
@@ -7,6 +7,7 @@
 
 /dts-v1/;
 
+#include <dt-bindings/arm/qcom,ids.h>
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/input/input.h>
 #include <dt-bindings/input/gpio-keys.h>
@@ -38,6 +39,14 @@ / {
 	model = "Xiaomi POCO X3 Pro";
 	compatible = "xiaomi,vayu", "qcom,sm8150";
 
+	/*
+	 * Needed by the Qualcomm bootloader (ABL) to pick this DTB.
+	 * Values from the vendor tree: sm8150-v2.dtsi (msm-id) and
+	 * vayu-sm8150-overlay.dts (board-id).
+	 */
+	qcom,msm-id = <QCOM_ID_SM8150 0x20000>;
+	qcom,board-id = <47 0>;
+
 	aliases {
 		serial0 = &uart2;
 		display0 = &framebuffer;
-- 
2.43.0

