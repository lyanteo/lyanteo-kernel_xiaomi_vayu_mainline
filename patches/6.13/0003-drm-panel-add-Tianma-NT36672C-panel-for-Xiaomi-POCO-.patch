+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Novatek NT36672C LCD panel (Tianma "36 02 0a") found in the
+ * Xiaomi POCO X3 Pro (vayu / j20s).
+ *
+ * Init sequence, timings and DSC parameters taken from the vendor device
+ * tree (dsi-panel-j20s-36-02-0a-lcd-dsc-vid.dtsi).
+ *
+ * The LCD bias rails (LAB/IBB from the PM8150L LCDB block) have no mainline
+ * driver yet, so they are optional here: when absent we rely on the
+ * bootloader leaving them enabled. Backlight is driven by PM8150L WLED.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+#include <video/mipi_display.h>
+
+struct nt36672c_j20s {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct drm_dsc_config dsc;
+	struct regulator *vddio;
+	struct regulator *lab;
+	struct regulator *ibb;
+	struct gpio_desc *reset_gpio;
+};
+
+static inline struct nt36672c_j20s *to_nt36672c_j20s(struct drm_panel *panel)
+{
+	return container_of(panel, struct nt36672c_j20s, panel);
+}
+
+/* qcom,mdss-dsi-reset-sequence = <1 5>, <0 1>, <1 10>; (GPIO is active low) */
+static void nt36672c_j20s_reset(struct nt36672c_j20s *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(5000, 6000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+}
+
+static void nt36672c_j20s_on(struct mipi_dsi_multi_context *dsi_ctx)
