+}
+
+static void nt36672c_j20s_off(struct mipi_dsi_multi_context *dsi_ctx)
+{
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xff, 0x27);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x3f, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xff, 0x10);
+	mipi_dsi_dcs_set_display_off_multi(dsi_ctx);
+	mipi_dsi_dcs_enter_sleep_mode_multi(dsi_ctx);
+	mipi_dsi_msleep(dsi_ctx, 70);
+}
+
+static int nt36672c_j20s_regulators_enable(struct nt36672c_j20s *ctx)
+{
+	int ret;
+
+	ret = regulator_enable(ctx->vddio);
+	if (ret)
+		return ret;
+	usleep_range(20000, 21000);
+
+	if (ctx->lab) {
+		ret = regulator_enable(ctx->lab);
+		if (ret)
+			goto err_vddio;
+	}
+
+	if (ctx->ibb) {
+		ret = regulator_enable(ctx->ibb);
+		if (ret)
+			goto err_lab;
+		usleep_range(20000, 21000);
+	}
+
+	return 0;
+
+err_lab:
+	if (ctx->lab)
+		regulator_disable(ctx->lab);
+err_vddio:
+	regulator_disable(ctx->vddio);
+	return ret;
+}
+
+static void nt36672c_j20s_regulators_disable(struct nt36672c_j20s *ctx)
+{
+	if (ctx->ibb)
+		regulator_disable(ctx->ibb);
+	if (ctx->lab)
+		regulator_disable(ctx->lab);
+	regulator_disable(ctx->vddio);
+}
+
+static int nt36672c_j20s_prepare(struct drm_panel *panel)
+{
+	struct nt36672c_j20s *ctx = to_nt36672c_j20s(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	struct drm_dsc_picture_parameter_set pps;
+	int ret;
+
+	ret = nt36672c_j20s_regulators_enable(ctx);
+	if (ret)
+		return ret;
+
+	nt36672c_j20s_reset(ctx);
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	nt36672c_j20s_on(&dsi_ctx);
+
+	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+	mipi_dsi_picture_parameter_set_multi(&dsi_ctx, &pps);
+	mipi_dsi_compression_mode_ext_multi(&dsi_ctx, true,
+					    MIPI_DSI_COMPRESSION_DSC, 0);
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	if (dsi_ctx.accum_err) {
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		nt36672c_j20s_regulators_disable(ctx);
+	}
+
+	return dsi_ctx.accum_err;
+}
+
+static int nt36672c_j20s_unprepare(struct drm_panel *panel)
+{
+	struct nt36672c_j20s *ctx = to_nt36672c_j20s(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	nt36672c_j20s_off(&dsi_ctx);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	nt36672c_j20s_regulators_disable(ctx);
+
+	return 0;
+}
+
+/* timing@0 from the vendor DT: 1080x2400@120, video mode */
+static const struct drm_display_mode nt36672c_j20s_mode = {
+	.clock = (1080 + 67 + 12 + 40) * (2400 + 33 + 2 + 30) * 120 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 67,
+	.hsync_end = 1080 + 67 + 12,
+	.htotal = 1080 + 67 + 12 + 40,
+	.vdisplay = 2400,
+	.vsync_start = 2400 + 33,
+	.vsync_end = 2400 + 33 + 2,
+	.vtotal = 2400 + 33 + 2 + 30,
+	.width_mm = 70,
+	.height_mm = 154,
+	.type = DRM_MODE_TYPE_DRIVER,
+};
+
+static int nt36672c_j20s_get_modes(struct drm_panel *panel,
+				   struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &nt36672c_j20s_mode);
+	if (!mode)
+		return -ENOMEM;
+
+	drm_mode_set_name(mode);
+
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+	drm_mode_probed_add(connector, mode);
+
+	return 1;
+}
+
+static const struct drm_panel_funcs nt36672c_j20s_panel_funcs = {
+	.prepare = nt36672c_j20s_prepare,
+	.unprepare = nt36672c_j20s_unprepare,
+	.get_modes = nt36672c_j20s_get_modes,
+};
+
+static struct regulator *nt36672c_j20s_get_optional(struct device *dev,
+						     const char *id)
+{
+	struct regulator *reg = devm_regulator_get_optional(dev, id);
+
+	if (IS_ERR(reg)) {
+		if (PTR_ERR(reg) == -ENODEV) {
+			dev_info(dev, "no %s supply, relying on bootloader state\n", id);
+			return NULL;
+		}
+		return reg;
+	}
+
+	return reg;
+}
+
+static int nt36672c_j20s_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct nt36672c_j20s *ctx;
+	int ret;
+
+	ctx = devm_kzalloc(dev, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+
+	ctx->vddio = devm_regulator_get(dev, "vddio");
+	if (IS_ERR(ctx->vddio))
+		return dev_err_probe(dev, PTR_ERR(ctx->vddio),
+				     "Failed to get vddio supply\n");
+
+	ctx->lab = nt36672c_j20s_get_optional(dev, "lab");
+	if (IS_ERR(ctx->lab))
+		return dev_err_probe(dev, PTR_ERR(ctx->lab),
+				     "Failed to get lab supply\n");
+
+	ctx->ibb = nt36672c_j20s_get_optional(dev, "ibb");
+	if (IS_ERR(ctx->ibb))
+		return dev_err_probe(dev, PTR_ERR(ctx->ibb),
+				     "Failed to get ibb supply\n");
+
+	/* Keep the panel as the bootloader left it until we take over. */
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_ASIS);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	drm_panel_init(&ctx->panel, dev, &nt36672c_j20s_panel_funcs,
+		       DRM_MODE_CONNECTOR_DSI);
+	ctx->panel.prepare_prev_first = true;
+
+	/* Backlight is provided by PM8150L WLED via the "backlight" property */
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to get backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	/* This panel only works with DSC enabled */
+	dsi->dsc = &ctx->dsc;
+	/*
+	 * TODO: vendor DT uses qcom,mdss-dsc-slice-per-pkt = <2>; msm DSI in
+	 * this kernel always sends one slice per packet. If the picture is
+	 * garbled, backport upstream slice_per_pkt support.
+	 */
+
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 1;
+	ctx->dsc.slice_height = 20;
+	ctx->dsc.slice_width = 540;
+	ctx->dsc.slice_count = 1080 / ctx->dsc.slice_width;
+	ctx->dsc.bits_per_component = 8;
+	ctx->dsc.bits_per_pixel = 8 << 4; /* 4 fractional bits */
+	ctx->dsc.block_pred_enable = true;
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		dev_err(dev, "Failed to attach to DSI host: %d\n", ret);
+		drm_panel_remove(&ctx->panel);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void nt36672c_j20s_remove(struct mipi_dsi_device *dsi)
+{
+	struct nt36672c_j20s *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id nt36672c_j20s_of_match[] = {
+	{ .compatible = "xiaomi,vayu-nt36672c-tianma" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, nt36672c_j20s_of_match);
+
+static struct mipi_dsi_driver nt36672c_j20s_driver = {
+	.probe = nt36672c_j20s_probe,
+	.remove = nt36672c_j20s_remove,
+	.driver = {
+		.name = "panel-novatek-nt36672c-j20s",
+		.of_match_table = nt36672c_j20s_of_match,
+	},
+};
+module_mipi_dsi_driver(nt36672c_j20s_driver);
+
+MODULE_DESCRIPTION("DRM driver for the Tianma NT36672C panel in Xiaomi POCO X3 Pro");
+MODULE_LICENSE("GPL");
