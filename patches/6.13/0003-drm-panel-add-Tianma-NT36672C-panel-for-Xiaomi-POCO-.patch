+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Xiaomi POCO X3 Pro (vayu) with the Tianma "36 02 0a" NT36672C panel.
+ *
+ * Experimental: enables MDSS/DSI and the panel driver instead of the
+ * bootloader simple-framebuffer. Use sm8150-xiaomi-vayu.dtb for a safe
+ * framebuffer-only boot.
+ *
+ * Panel data from the vendor tree (sm8150-sde-display.dtsi,
+ * xiaomi-sm8150-common.dtsi, vayu-sm8150.dtsi).
+ */
+
+#include "sm8150-xiaomi-vayu.dts"
+
+/ {
+	model = "Xiaomi POCO X3 Pro (Tianma panel)";
+
+	chosen {
+		/delete-node/ framebuffer@9c000000;
+	};
+
+	aliases {
+		/delete-property/ display0;
+	};
+
+	/* Downstream "disp_vci_vreg" (sde_dsi vcie-supply), GPIO 21 */
+	disp_vci_vreg: regulator-disp-vci {
+		compatible = "regulator-fixed";
+		regulator-name = "disp_vci";
+		gpio = <&tlmm 21 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <4000>;
+		regulator-boot-on;
+		/* No consumer in mainline yet; keep the panel rail up */
+		regulator-always-on;
+	};
+};
+
+&dispcc {
+	status = "okay";
+};
+
+&mdss {
+	status = "okay";
+};
+
+&mdss_mdp {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	vdda-supply = <&vreg_l3c_1p2>;
+	status = "okay";
+
+	panel@0 {
+		compatible = "xiaomi,vayu-nt36672c-tianma";
+		reg = <0>;
+
+		vddio-supply = <&vreg_l14a_1p88>;
+		/* lab/ibb: PM8150L LCDB has no mainline driver, left to bootloader */
+
+		reset-gpios = <&tlmm 6 GPIO_ACTIVE_LOW>;
+		backlight = <&pm8150l_wled>;
+
+		pinctrl-0 = <&panel_default>;
+		pinctrl-names = "default";
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel_in>;
+	data-lanes = <0 1 2 3>;
+};
+
+&mdss_dsi0_phy {
+	vdds-supply = <&vreg_l5a_0p875>;
+	status = "okay";
+};
+
+/* downstream: qcom,string-cfg = <7> (strings 0..2), ovp 28V, 22.5 mA */
+&pm8150l_wled {
+	qcom,num-strings = <3>;
+	qcom,ovp-millivolt = <28000>;
+	qcom,current-limit-microamp = <22500>;
+	qcom,cabc;
+	status = "okay";
+};
+
+&tlmm {
+	panel_default: panel-default-state {
+		reset-pins {
+			pins = "gpio6";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		te-pins {
+			pins = "gpio8";
+			function = "mdp_vsync";
+			drive-strength = <2>;
+			bias-pull-down;
+		};
+	};
+};
