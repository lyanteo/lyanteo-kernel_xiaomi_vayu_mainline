+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x62, 0xcb);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x63, 0xbf);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x64, 0xb3);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x65, 0xb2);
