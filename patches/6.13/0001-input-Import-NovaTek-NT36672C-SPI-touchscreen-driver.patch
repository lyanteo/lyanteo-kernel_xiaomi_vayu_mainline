+/*******************************************************
+Description:
+	Novatek touchscreen /proc/nvt_diff open function.
+return:
+	Executive outcomes. 0---succeed. negative---failed.
+*******************************************************/
+static int32_t nvt_diff_open(struct inode *inode, struct file *file)
