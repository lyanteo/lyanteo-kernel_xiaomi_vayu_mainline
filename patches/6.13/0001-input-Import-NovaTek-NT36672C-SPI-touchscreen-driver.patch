+#else  /*NO __KERNEL__*/
+#define PDEBUG(fmt, args...)fprintf(stderr, TP_TAG fmt, ##args)
+#endif /*END __KERNEL__*/
+#else  /*NO TP_SPI_DEBUG*/
+#define PDEBUG(fmt, args...)
+#endif /*END TP_SPI_DEBUG*/
+
+#undef PDEBUGG
