+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/sysfs.h>
+
+#define TP_SPI_DEBUG
+
+#define TP_TAG	"[TP_SPI]: "
+
+#undef PDEBUG
+#ifdef TP_SPI_DEBUG
