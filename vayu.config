# Opsi khusus POCO X3 Pro (di atas defconfig + sm8150.config)
CONFIG_DRM_PANEL_NOVATEK_NT36672C_J20S=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_EXFAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_MMC_BLOCK=y
# Hanya untuk uji QEMU (kartu SD virtual); tidak ada hardware ini di vayu
CONFIG_MMC_SDHCI_PCI=y
# Dump ramoops tanpa kompresi, agar bisa dibaca kernel Android (crDroid)
# CONFIG_PSTORE_COMPRESS is not set
