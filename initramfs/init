#!/bin/busybox sh
# Minimal debug initramfs for POCO X3 Pro (vayu) mainline bring-up.
#
# After boot the phone exposes over USB:
#   - a serial console (CDC ACM)  -> Windows: COMx in Device Manager, open with PuTTY 115200
#                                  -> Linux:   /dev/ttyACM0 (screen /dev/ttyACM0 115200)
#   - a network interface (NCM)   -> telnet 172.16.42.1
# Logs are also copied to /log on the device (dmesg, pstore from a previous crash).

/bin/busybox --install -s /bin
export PATH=/bin

mkdir -p /proc /sys /dev /tmp /log /config
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /tmp
mount -t configfs configfs /config 2>/dev/null || mount -t configfs configfs /sys/kernel/config
mkdir -p /sys/fs/pstore
mount -t pstore pstore /sys/fs/pstore 2>/dev/null

echo "vayu-initramfs: started" > /dev/kmsg

# Save the previous crash log (ramoops) if any
cp -r /sys/fs/pstore /log/pstore 2>/dev/null

# --- USB gadget: ACM serial + NCM network ---
G=/config/usb_gadget/g1
[ -d /config/usb_gadget ] || G=/sys/kernel/config/usb_gadget/g1
mkdir -p $G
echo 0x18d1 > $G/idVendor
echo 0xd001 > $G/idProduct
mkdir -p $G/strings/0x409
echo "vayu-mainline" > $G/strings/0x409/serialnumber
echo "postmarket-style" > $G/strings/0x409/manufacturer
echo "POCO X3 Pro mainline debug" > $G/strings/0x409/product
mkdir -p $G/functions/acm.usb0 $G/functions/ncm.usb0
mkdir -p $G/configs/c.1/strings/0x409
echo "acm+ncm" > $G/configs/c.1/strings/0x409/configuration
ln -s $G/functions/acm.usb0 $G/configs/c.1/
ln -s $G/functions/ncm.usb0 $G/configs/c.1/

# Wait for the USB controller to show up
i=0
while [ -z "$(ls /sys/class/udc 2>/dev/null)" ] && [ $i -lt 30 ]; do
	sleep 1; i=$((i+1))
done
UDC=$(ls /sys/class/udc | head -n1)
echo "vayu-initramfs: udc='$UDC'" > /dev/kmsg
echo "$UDC" > $G/UDC

sleep 2
ifconfig usb0 172.16.42.1 netmask 255.255.255.0 up 2>/dev/null
udhcpd_conf=/tmp/udhcpd.conf
cat > $udhcpd_conf <<EOF
start 172.16.42.2
end 172.16.42.2
interface usb0
option subnet 255.255.255.0
EOF
touch /tmp/udhcpd.leases
udhcpd -S $udhcpd_conf 2>/dev/null
telnetd -b 172.16.42.1:23 -l /bin/sh 2>/dev/null

# Keep a copy of the kernel log
dmesg > /log/dmesg-boot.txt

say() {
	echo "VAYU-TES: $*" > /dev/kmsg
	echo "VAYU-TES: $*" > /dev/tty0 2>/dev/null
}

echo "vayu-initramfs: ready (serial ttyGS0, telnet 172.16.42.1)" > /dev/kmsg
echo "vayu-initramfs: ready (serial ttyGS0, telnet 172.16.42.1)" > /dev/tty0 2>/dev/null

# Ringkasan kondisi hardware -> masuk log kernel -> tersimpan di ramoops,
# bisa dibaca dari recovery tanpa foto layar.
say "kernel $(uname -r) model: $(cat /proc/device-tree/model 2>/dev/null)"
say "memori: $(grep MemTotal /proc/meminfo)"
say "cpu online: $(cat /sys/devices/system/cpu/online 2>/dev/null)"
say "udc: '$UDC'  usb0: $(cat /sys/class/net/usb0/operstate 2>/dev/null)"
say "drm: $(ls /sys/class/drm 2>/dev/null | tr '\n' ' ')"
say "fb: $(ls /sys/class/graphics 2>/dev/null | tr '\n' ' ')"
say "block: $(ls /sys/class/block 2>/dev/null | head -n 16 | tr '\n' ' ')"
say "input: $(grep -h '^N:' /proc/bus/input/devices 2>/dev/null | tr '\n' ' ')"
say "baterai: $(cat /sys/class/power_supply/*/capacity 2>/dev/null | tr '\n' ' ')"
say "thermal0: $(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)"
say "remoteproc: $(cat /sys/class/remoteproc/*/state 2>/dev/null | tr '\n' ' ')"
say "pstore: [$(ls /sys/fs/pstore 2>/dev/null | tr '\n' ' ')] ramoops: $(dmesg | grep -i ramoops | tail -n 2 | tr '\n' ' ')"
say "reboot: $(grep -o 'reboot=[a-z]*' /proc/cmdline) psci: $(dmesg | grep -i 'psci' | grep -iE 'v[0-9]|reset2|SYSTEM_RESET' | head -n 2 | tr '\n' ' ')"
say "probe gagal: $(dmesg | grep -ciE 'probe.*failed|failed to probe|error -')"
dmesg | grep -iE 'probe.*failed|failed to probe' | head -n 15 | while read -r l; do say "  $l"; done

# Simpan log ke microSD (kalau ada). HANYA mmcblk* (microSD), TIDAK PERNAH
# sda* (penyimpanan UFS HP). Hanya FAT32/exFAT, dan selalu di-unmount.
simpan_ke_sd() {
	i=0
	while [ -z "$(ls /sys/class/block 2>/dev/null | grep '^mmcblk')" ] && [ $i -lt 30 ]; do
		sleep 1; i=$((i+1))
	done
	say "microSD: blok=[$(ls /sys/class/block 2>/dev/null | grep '^mmcblk' | tr '\n' ' ')] setelah ${i}s"
	dmesg | grep -iE 'mmc[0-9]|sdhci|8804000' | tail -n 6 | while read -r l; do say "  sd: $l"; done
	for dev in $(ls /sys/class/block 2>/dev/null | grep '^mmcblk[0-9]*p[0-9]*$'; \
		     ls /sys/class/block 2>/dev/null | grep '^mmcblk[0-9]*$'); do
		mkdir -p /mnt/sd
		for fs in vfat exfat; do
			if mount -t $fs -o rw,sync,noatime /dev/$dev /mnt/sd 2>/tmp/mnt.err; then
				mkdir -p /mnt/sd/vayu-log
				n=1
				while [ -e /mnt/sd/vayu-log/log-$n.txt ]; do n=$((n+1)); done
				{
					echo "=== $1 ==="
					cat /proc/cmdline
					echo
					dmesg
				} > /mnt/sd/vayu-log/log-$n.txt
				sync
				umount /mnt/sd
				say "log disimpan ke microSD ($dev, $fs): vayu-log/log-$n.txt"
				return 0
			fi
		done
	done
	say "microSD tidak ditemukan / bukan FAT32/exFAT; log hanya di ramoops ($(cat /tmp/mnt.err 2>/dev/null | head -c 120))"
	return 1
}
simpan_ke_sd "setelah init siap"

# Restart otomatis ke recovery setelah 60 detik (kecuali cmdline berisi
# vayu.tetap), supaya log di atas bisa dibaca di recovery:
#   cat /sys/fs/pstore/console-ramoops*
if ! grep -q 'vayu.tetap' /proc/cmdline; then
	for i in 60 45 30 15; do
		say "restart ke RECOVERY dalam $i detik (ambil log di sana)"
		sleep 15
	done
	simpan_ke_sd "sebelum restart ke recovery"
	say "restart ke recovery sekarang"
	sync
	/bin/reboot-recovery
	# Jangan reboot biasa: itu memuat kernel tes ini lagi (loop).
	say "reboot-recovery gagal; tetap menyala. Tahan Power 15 dtk, lalu Vol Atas + Power"
fi

# Shell on the USB serial port, respawned forever; never exit PID 1
while true; do
	if [ -e /dev/ttyGS0 ]; then
		setsid sh -c 'exec sh </dev/ttyGS0 >/dev/ttyGS0 2>&1'
	else
		sleep 5
	fi
done
